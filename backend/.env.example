# =========================
# APP
# =========================
FRONTEND_URL=여기에_프론트_접속주소_입력

# =========================
# CLOUDFLARE R2
# =========================
# Cloudflare R2 공개 베이스 URL (끝에 / 없이 입력)
R2_PUBLIC_BASE_URL=여기에_클라우드플레어_R2_공개주소_입력
# R2 안에서 커버 이미지가 저장된 폴더 경로
R2_COVER_PREFIX=cover
# R2 안에서 음원 파일이 저장된 폴더 경로
R2_AUDIO_PREFIX=audio
# R2 안에서 영상 파일이 저장된 폴더 경로
R2_VIDEO_PREFIX=video

# =========================
# DB
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=여기에_DB_이름_입력
DB_USER=여기에_DB_계정명_입력
DB_PASS=여기에_DB_비밀번호_입력
DB_CHARSET=utf8mb4

# =========================
# OPENAI
# =========================
OPENAI_API_KEY=여기에_OPENAI_API_KEY_입력
OPENAI_MODEL=gpt-5.4-mini

# =========================
# KAKAO
# =========================
KAKAO_CLIENT_ID=여기에_카카오_REST_API_키_입력
KAKAO_CLIENT_SECRET=여기에_카카오_Client_Secret_입력
KAKAO_REDIRECT_URI=여기에_카카오_콜백_URL_입력

# =========================
# GOOGLE
# =========================
# Google Cloud OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=여기에_구글_Client_ID_입력
GOOGLE_CLIENT_SECRET=여기에_구글_Client_Secret_입력
GOOGLE_REDIRECT_URI=여기에_구글_콜백_URL_입력

# =========================
# NAVER
# =========================
NAVER_CLIENT_ID=여기에_네이버_Client_ID_입력
NAVER_CLIENT_SECRET=여기에_네이버_Client_Secret_입력
NAVER_REDIRECT_URI=여기에_네이버_콜백_URL_입력
